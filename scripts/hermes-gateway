#!/usr/bin/env python3
"""Project-local gateway launcher.

This checkout runs Hermes in a project-local mode. The gateway can run in the
foreground, but host-level system services are intentionally disabled.
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
PROJECT_DIR = SCRIPT_DIR.parent
RUNNER = PROJECT_DIR / "run-hermes-local.sh"


def _run_foreground() -> int:
    env = {**os.environ, "HERMES_PROJECT_ROOT": str(PROJECT_DIR)}
    return subprocess.run(
        [str(RUNNER), "gateway", "run"],
        cwd=str(PROJECT_DIR),
        env=env,
        check=False,
    ).returncode


def _unsupported(command: str) -> int:
    print(
        f"`scripts/hermes-gateway {command}` is disabled in project-local mode.\n"
        "Use `./run-hermes-local.sh gateway run` to run the gateway in the foreground."
    )
    return 1


def main() -> int:
    parser = argparse.ArgumentParser(description="Project-local Hermes gateway launcher")
    parser.add_argument(
        "command",
        nargs="?",
        default="run",
        choices=["run", "install", "uninstall", "start", "stop", "restart", "status"],
        help="Gateway action",
    )
    args = parser.parse_args()

    if args.command == "run":
        return _run_foreground()
    return _unsupported(args.command)


if __name__ == "__main__":
    raise SystemExit(main())
